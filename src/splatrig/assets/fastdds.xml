<?xml version="1.0" encoding="UTF-8" ?>
<!-- SPDX-License-Identifier: MIT
     Shared memory first, then UDP with 4 MiB socket buffers. A ~380 KB Livox
     frame overflows the 208 KiB default receive buffer and best-effort
     delivery then drops the whole frame. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_large</transport_id>
      <type>UDPv4</type>
      <receiveBufferSize>4194304</receiveBufferSize>
      <sendBufferSize>4194304</sendBufferSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="splatrig_default" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm</transport_id>
        <transport_id>udp_large</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
